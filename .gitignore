# Node / editor
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Compiler/build artifacts
.bootstrap/
.build/
/build
.cache/
.tmp/
