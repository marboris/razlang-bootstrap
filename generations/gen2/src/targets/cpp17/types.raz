// Raz declarations are never emitted with their source spelling. Encode each
// ASCII identifier as length + decimal character codes. This is deterministic,
// injective for the lexer's identifier alphabet, valid in C++, and deliberately
// keeps the source name opaque to the C++ layer. Native `name!(...)` calls are
// the only exception because they explicitly name an external C++ API.
function cppMangledName(prefix: string, name: string) -> string {
    let out: string = prefix + "_n" + int_to_string(length(name));
    let i: i64 = 0;
    while (i < length(name)) {
        out = out + "_" + int_to_string(name[i]);
        i = i + 1;
    }
    return out;
}

function cppVariableName(name: string) -> string {
    return cppMangledName("raz_v", name);
}

function cppFunctionName(name: string) -> string {
    return cppMangledName("raz_fn", name);
}

function cppStructName(name: string) -> string {
    return cppMangledName("raz_ty", name);
}

function cppFieldName(name: string) -> string {
    return cppMangledName("raz_field", name);
}

// Calls that bind to a Raz function are mangled. Calls provided by an
// explicitly imported C++ library (including current generic container
// templates) keep their native spelling; no library names are hard-coded.
function cppCallName(module: Ref<BackendModule>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(module.functions)) {
        if (module.functions[i].name == name) return cppFunctionName(name);
        i = i + 1;
    }
    return name;
}

function cppType(t: string) -> string {
    if (t == "void") return "void";
    // Use GCC/Clang's predefined underlying type so the Raz primitive i64 does
    // not force an implicit <cstdint> include into every generated program.
    // The build target is the GNU-compatible C++ toolchain; the static assertion
    // emitted by generate() verifies that this target provides an exact 64-bit type.
    if (t == "i64") return "raz_i64";
    if (t == "f64") return "double";
    if (t == "bool") return "bool";
    if (t == "char") return "char";
    if (t == "string") return "std::string";
    if (starts(t, "List<")) {
        let inner: string = slice(t, 5, length(t) - 1);
        return "std::vector<" + cppType(inner) + ">";
    }
    if (starts(t, "Ref<")) {
        let inner: string = slice(t, 4, length(t) - 1);
        return cppType(inner) + "&";
    }
    if (endsWith(t, "*")) return cppType(slice(t, 0, length(t) - 1)) + "*";
    return cppStructName(t);
}

function valueName(v: string) -> string {
    let x: string = trim(v);
    if (starts(x, "%")) return "t" + slice(x, 1, length(x));
    return x;
}

function aliasValue(state: Ref<BackendState>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(state.aliasNames)) {
        if (state.aliasNames[i] == name) return state.aliasValues[i];
        i = i + 1;
    }
    return name;
}

function simpleRazIdentifier(value: string) -> bool {
    if (value == "") return false;
    let first: i64 = charCodeAt(value, 0);
    if (!((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95)) return false;
    let i: i64 = 1;
    while (i < length(value)) {
        let c: i64 = charCodeAt(value, i);
        if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)) return false;
        i = i + 1;
    }
    return true;
}

function cppValue(state: Ref<BackendState>, value: string) -> string {
    let x: string = trim(value);
    if (starts(x, "%") && findText(x, "%t", 0) == 0) return aliasValue(state, valueName(x));
    if (findText(x, "%t", 0) < 0) {
        if (x == "true" || x == "false" || x == "nullptr") return x;
        // Compiler-generated local symbols are intentionally outside Raz's
        // identifier alphabet, then mangled into ordinary C++ identifiers.
        if (starts(x, "raz$local$")) return cppVariableName(x);
        if (simpleRazIdentifier(x)) return cppVariableName(x);
        return x;
    }
    let out: string = "";
    let i: i64 = 0;
    while (i < length(x)) {
        if (i + 2 < length(x) && slice(x, i, i + 2) == "%t" && charCodeAt(x, i + 2) >= 48 && charCodeAt(x, i + 2) <= 57) {
            let end: i64 = i + 2;
            while (end < length(x) && charCodeAt(x, end) >= 48 && charCodeAt(x, end) <= 57) end = end + 1;
            let name: string = "t" + slice(x, i + 2, end);
            out = out + aliasValue(state, name);
            i = end;
        } else {
            out = out + slice(x, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

function topLevelComma(value: string) -> i64 {
    let depth: i64 = 0;
    let i: i64 = 0;
    while (i < length(value)) {
        if (charCodeAt(value, i) == 40 || charCodeAt(value, i) == 91 || charCodeAt(value, i) == 123) depth = depth + 1;
        else if (charCodeAt(value, i) == 41 || charCodeAt(value, i) == 93 || charCodeAt(value, i) == 125) depth = depth - 1;
        else if (charCodeAt(value, i) == 44 && depth == 0) return i;
        i = i + 1;
    }
    return -1;
}

function setAlias(state: Ref<BackendState>, name: string, value: string) {
    let i: i64 = 0;
    while (i < listLength(state.aliasNames)) {
        if (state.aliasNames[i] == name) {
            state.aliasValues[i] = value;
            return;
        }
        i = i + 1;
    }
    push(state.aliasNames, name);
    push(state.aliasValues, value);
}

function cppRirArgs(state: Ref<BackendState>, values: Ref<List<string>>) -> string {
    let out: string = "";
    let i: i64 = 0;
    while (i < listLength(values)) {
        if (i > 0) out = out + ", ";
        out = out + cppValue(state, values[i]);
        i = i + 1;
    }
    return out;
}

function cppArgs(state: Ref<BackendState>, values: string) -> string {
    let out: string = "";
    let start: i64 = 0;
    let depth: i64 = 0;
    let i: i64 = 0;
    while (i <= length(values)) {
        if (i < length(values) && (charCodeAt(values, i) == 40 || charCodeAt(values, i) == 91 || charCodeAt(values, i) == 123)) depth = depth + 1;
        else if (i < length(values) && (charCodeAt(values, i) == 41 || charCodeAt(values, i) == 93 || charCodeAt(values, i) == 125)) depth = depth - 1;
        if (i == length(values) || (charCodeAt(values, i) == 44 && depth == 0)) {
            let item: string = trim(slice(values, start, i));
            if (item != "") {
                if (out != "") out = out + ", ";
                out = out + cppValue(state, item);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

function localIndex(state: Ref<BackendState>, name: string) -> i64 {
    let i: i64 = listLength(state.locals) - 1;
    while (i >= 0) {
        if (state.locals[i] == name) return i;
        i = i - 1;
    }
    return -1;
}

// RIR temporary names are numeric (`tN` after removing `%`). Allocate the
// function's temp range once and use direct indexing, avoiding repeated linear
// scans in value/type inference. A temp may be assigned on multiple control-flow
// edges; all such assignments share a single declaration and inferred type.
function tempNumber(name: string) -> i64 {
    // valueName() canonicalizes `%t123` to `tt123` for the C++ emitter.
    if (!starts(name, "tt") || length(name) < 3) return -1;
    let n: i64 = 0;
    let i: i64 = 2;
    while (i < length(name)) {
        let c: i64 = charCodeAt(name, i);
        if (c < 48 || c > 57) return -1;
        n = n * 10 + c - 48;
        i = i + 1;
    }
    return n;
}

function tempSlot(state: Ref<BackendState>, name: string) -> i64 {
    let n: i64 = tempNumber(name);
    if (n < state.tempBase) return -1;
    let slot: i64 = n - state.tempBase;
    if (slot < 0 || slot >= listLength(state.temps)) return -1;
    if (state.temps[slot] != name) return -1;
    return slot;
}

function addTemp(state: Ref<BackendState>, name: string, type: string) {
    let slot: i64 = tempSlot(state, name);
    if (slot < 0) return;
    if (state.tempTypes[slot] == "") {
        state.tempTypes[slot] = type;
    } else if (state.tempTypes[slot] == "i64" && type != "i64") {
        state.tempTypes[slot] = type;
    } else if (state.tempTypes[slot] == "List<i64>" && starts(type, "List<")) {
        state.tempTypes[slot] = type;
    }
}

function tempType(state: Ref<BackendState>, name: string) -> string {
    let slot: i64 = tempSlot(state, name);
    if (slot < 0 || state.tempTypes[slot] == "") return "i64";
    return state.tempTypes[slot];
}

function setTempType(state: Ref<BackendState>, name: string, type: string) {
    let slot: i64 = tempSlot(state, name);
    if (slot >= 0) state.tempTypes[slot] = type;
}

function refineListType(state: Ref<BackendState>, value: string, expected: string) {
    let x: string = trim(value);
    if (!starts(x, "%") || !starts(expected, "List<")) return;
    let name: string = valueName(x);
    if (tempType(state, name) == "List<i64>") setTempType(state, name, expected);
}

function findVarType(f: Ref<FunctionMeta>, state: Ref<BackendState>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(f.params)) {
        if (f.params[i] == name) return f.paramTypes[i];
        i = i + 1;
    }
    i = listLength(state.locals) - 1;
    while (i >= 0) {
        if (state.locals[i] == name) return state.localTypes[i];
        i = i - 1;
    }
    return "i64";
}

function valueType(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>, value: string) -> string {
    let x: string = trim(value);
    let type: string = "";
    if (starts(x, "%")) type = tempType(state, valueName(x));
    else if (x == "true" || x == "false") return "bool";
    else if (starts(x, "\"")) return "string";
    else type = findVarType(f, state, x);
    // Reading a place yields T, even when its storage/parameter is Ref<T>.
    // Explicit reference operations infer Ref<T> in their own branches.
    if (starts(type, "Ref<") && length(type) > 5) return slice(type, 4, length(type) - 1);
    return type;
}

function functionReturnType(module: Ref<BackendModule>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(module.functions)) {
        if (module.functions[i].name == name) return module.functions[i].returnType;
        i = i + 1;
    }
    if (name == "listLength") return "i64";
    if (name == "push") return "void";
    return "i64";
}

function structFieldType(module: Ref<BackendModule>, type: string, field: string) -> string {
    let name: string = type;
    if (starts(name, "Ref<")) name = slice(name, 4, length(name) - 1);
    let generic: i64 = findText(name, "<", 0);
    if (generic >= 0) name = slice(name, 0, generic);
    let i: i64 = 0;
    while (i < listLength(module.structs)) {
        let st: StructMeta = module.structs[i];
        if (st.name == name) {
            let j: i64 = 0;
            while (j < listLength(st.fields)) {
                if (st.fields[j] == field) return st.fieldTypes[j];
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "i64";
}

function globalType(module: Ref<BackendModule>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(module.globals)) {
        if (module.globals[i].name == name) return module.globals[i].type;
        i = i + 1;
    }
    return "i64";
}

function inferInstructionType(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>, ins: Ref<RirInstruction>) -> string {
    let op: string = ins.opcode;
    if (op == "copy") return valueType(module, f, state, ins.operands[0]);
    if (op == "load") {
        let name: string = ins.operands[0];
        let i: i64 = 0;
        while (i < listLength(f.params)) {
            if (f.params[i] == name) return f.paramTypes[i];
            i = i + 1;
        }
        if (localIndex(state, name) >= 0) return findVarType(f, state, name);
        return globalType(module, name);
    }
    if (op == "ref") {
        let type: string = findVarType(f, state, ins.operands[0]);
        if (starts(type, "Ref<")) return type;
        return "Ref<" + type + ">";
    }
    if (op == "ref_field") {
        let baseType: string = valueType(module, f, state, ins.operands[0]);
        return "Ref<" + structFieldType(module, baseType, ins.operands[1]) + ">";
    }
    if (op == "ref_index") {
        let baseType: string = valueType(module, f, state, ins.operands[0]);
        if (starts(baseType, "Ref<")) baseType = slice(baseType, 4, length(baseType) - 1);
        if (starts(baseType, "List<")) return "Ref<" + slice(baseType, 5, length(baseType) - 1) + ">";
    }
    if (op == "const") return ins.type;
    if (op == "new") return ins.type;
    if (op == "field") return structFieldType(module, valueType(module, f, state, ins.operands[0]), ins.operands[1]);
    if (op == "index") {
        let baseType: string = valueType(module, f, state, ins.operands[0]);
        let sequenceType: string = baseType;
        if (starts(sequenceType, "Ref<")) sequenceType = slice(sequenceType, 4, length(sequenceType) - 1);
        if (starts(sequenceType, "List<")) return slice(sequenceType, 5, length(sequenceType) - 1);
        if (baseType == "string") return "i64";
    }
    if (op == "list") {
        if (listLength(ins.operands) == 0) return "List<i64>";
        return "List<" + valueType(module, f, state, ins.operands[0]) + ">";
    }
    if (op == "call-result") {
        if (ins.name == "append" && listLength(ins.operands) > 0) return valueType(module, f, state, ins.operands[0]);
        return functionReturnType(module, ins.name);
    }
    if (op == "eq" || op == "ne" || op == "lt" || op == "le" || op == "gt" || op == "ge" || op == "and" || op == "or" || op == "not") return "bool";
    if (op == "add" || op == "sub" || op == "mul" || op == "div" || op == "mod" || op == "neg" || op == "pos") {
        if (listLength(ins.operands) == 0) return "i64";
        let leftType: string = valueType(module, f, state, ins.operands[0]);
        if (op == "add" && leftType == "string") return "string";
        return leftType;
    }
    return "i64";
}

function collectDeclarations(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>) {
    state.temps = [];
    state.tempTypes = [];
    state.tempBase = 0;
    state.locals = [];
    state.localTypes = [];
    state.localAutos = [];
    state.localInitValues = [];
    state.aliasNames = [];
    state.aliasValues = [];

    let i: i64 = 0;
    while (i < listLength(f.instructions)) {
        let ins: RirInstruction = f.instructions[i];
        if (ins.opcode == "local" || ins.opcode == "local-auto") {
            push(state.localTypes, ins.type);
            push(state.locals, ins.name);
            push(state.localAutos, ins.opcode == "local-auto");
            push(state.localInitValues, "");
        }
        i = i + 1;
    }

    // Reserve the numeric temporary span once, then index by tN directly.
    let minTemp: i64 = 2147483647;
    let maxTemp: i64 = -1;
    i = 0;
    while (i < listLength(f.instructions)) {
        let ins: RirInstruction = f.instructions[i];
        if (ins.result != "") {
            let id: i64 = tempNumber(valueName(ins.result));
            if (id >= 0 && id < minTemp) minTemp = id;
            if (id > maxTemp) maxTemp = id;
        }
        i = i + 1;
    }
    if (maxTemp >= minTemp) {
        state.tempBase = minTemp;
        let id: i64 = minTemp;
        while (id <= maxTemp) {
            push(state.temps, "tt" + int_to_string(id));
            push(state.tempTypes, "");
            id = id + 1;
        }
    }

    i = 0;
    while (i < listLength(f.instructions)) {
        let ins: RirInstruction = f.instructions[i];
        if (ins.result != "") addTemp(state, valueName(ins.result), inferInstructionType(module, f, state, ins));
        i = i + 1;
    }

    i = 0;
    while (i < listLength(f.instructions)) {
        let ins: RirInstruction = f.instructions[i];
        if (ins.opcode == "store" && listLength(ins.operands) >= 2) {
            let localId: i64 = localIndex(state, ins.operands[0]);
            if (localId >= 0 && state.localAutos[localId] && state.localInitValues[localId] == "") state.localInitValues[localId] = ins.operands[1];
            refineListType(state, ins.operands[1], findVarType(f, state, ins.operands[0]));
        } else if (ins.opcode == "field_set" && listLength(ins.operands) >= 2) {
            let target: string = ins.operands[0];
            let dot: i64 = findText(target, ".", 0);
            if (dot >= 0) {
                let base: string = trim(slice(target, 0, dot));
                let field: string = trim(slice(target, dot + 1, length(target)));
                let expected: string = structFieldType(module, findVarType(f, state, base), field);
                refineListType(state, ins.operands[1], expected);
            }
        } else if (ins.opcode == "store_ref" && listLength(ins.operands) >= 2) {
            let refName: string = valueName(ins.operands[0]);
            let refType: string = tempType(state, refName);
            if (starts(refType, "Ref<") && length(refType) > 5) {
                let expected: string = slice(refType, 4, length(refType) - 1);
                refineListType(state, ins.operands[1], expected);
            }
        }
        i = i + 1;
    }
}
