// RIR-1 verifier. This is a compiler stage, not a debugging utility: it rejects
// malformed or unsupported intermediate operations before target lowering.

function gen2RirTrim(value: string) -> string {
    let a: i64 = 0;
    let b: i64 = length(value);
    while (a < b && (charCodeAt(value, a) == 32 || charCodeAt(value, a) == 9 || charCodeAt(value, a) == 13)) a = a + 1;
    while (b > a && (charCodeAt(value, b - 1) == 32 || charCodeAt(value, b - 1) == 9 || charCodeAt(value, b - 1) == 13)) b = b - 1;
    return slice(value, a, b);
}

function gen2RirStarts(value: string, prefix: string) -> bool {
    if (length(value) < length(prefix)) return false;
    return slice(value, 0, length(prefix)) == prefix;
}

function gen2RirFind(value: string, needle: string) -> i64 {
    let i: i64 = 0;
    let n: i64 = length(needle);
    if (n == 0) return 0;
    while (i + n <= length(value)) {
        if (slice(value, i, i + n) == needle) return i;
        i = i + 1;
    }
    return -1;
}

function gen2RirKnownRhs(rhs: string) -> bool {
    if (gen2RirStarts(rhs, "const i64 ") || gen2RirStarts(rhs, "const string ") ||
        gen2RirStarts(rhs, "const char ") || gen2RirStarts(rhs, "const bool ") ||
        gen2RirStarts(rhs, "const char* ")) return true;
    if (gen2RirStarts(rhs, "load ") || gen2RirStarts(rhs, "copy ") ||
        gen2RirStarts(rhs, "ref ") || gen2RirStarts(rhs, "ref_field ") ||
        gen2RirStarts(rhs, "ref_index ") || gen2RirStarts(rhs, "new ") ||
        gen2RirStarts(rhs, "field ") || gen2RirStarts(rhs, "index ") ||
        gen2RirStarts(rhs, "call ") || gen2RirStarts(rhs, "list(")) return true;
    if (gen2RirStarts(rhs, "add ") || gen2RirStarts(rhs, "sub ") ||
        gen2RirStarts(rhs, "mul ") || gen2RirStarts(rhs, "div ") ||
        gen2RirStarts(rhs, "mod ") || gen2RirStarts(rhs, "eq ") ||
        gen2RirStarts(rhs, "ne ") || gen2RirStarts(rhs, "lt ") ||
        gen2RirStarts(rhs, "le ") || gen2RirStarts(rhs, "gt ") ||
        gen2RirStarts(rhs, "ge ") || gen2RirStarts(rhs, "and ") ||
        gen2RirStarts(rhs, "or ") || gen2RirStarts(rhs, "neg ") ||
        gen2RirStarts(rhs, "not ") || gen2RirStarts(rhs, "pos ")) return true;
    return false;
}

function gen2RirKnownFunctionLine(line: string) -> bool {
    if (line == "entry:" || line == "return" || gen2RirStarts(line, "return ") ||
        gen2RirStarts(line, "local ") || gen2RirStarts(line, "local-auto ") ||
        gen2RirStarts(line, "store ") || gen2RirStarts(line, "store_ref ") ||
        gen2RirStarts(line, "jump ") || gen2RirStarts(line, "branch ") ||
        gen2RirStarts(line, "native-call ") || gen2RirStarts(line, "call ")) return true;
    if (length(line) > 1 && charCodeAt(line, length(line) - 1) == 58) return true;
    let assignment: i64 = gen2RirFind(line, " = ");
    if (gen2RirStarts(line, "%t") && assignment > 2) {
        return gen2RirKnownRhs(gen2RirTrim(slice(line, assignment + 3, length(line))));
    }
    return false;
}

function validateRir1(rir: string) -> string {
    if (!gen2RirStarts(rir, "rir 1\n")) return "expected RIR version header 'rir 1'";

    let inFunction: bool = false;
    let hasFunction: bool = false;
    let lastWasStruct: bool = false;
    let lineNumber: i64 = 1;
    let start: i64 = 0;
    let i: i64 = 0;
    while (i <= length(rir)) {
        if (i == length(rir) || charCodeAt(rir, i) == 10) {
            let line: string = gen2RirTrim(slice(rir, start, i));
            start = i + 1;
            if (line != "" && line != "rir 1") {
                if (inFunction) {
                    if (line == "endfunction") {
                        inFunction = false;
                    } else if (!gen2RirKnownFunctionLine(line)) {
                        return "unsupported RIR instruction at line " + int_to_string(lineNumber) + ": " + line;
                    } else if (gen2RirStarts(line, "branch ") &&
                        (gen2RirFind(line, " ? ") < 0 || gen2RirFind(line, " : ") < 0)) {
                        return "malformed branch at RIR line " + int_to_string(lineNumber);
                    } else if (gen2RirStarts(line, "store ") && gen2RirFind(line, ", ") < 0) {
                        return "malformed store at RIR line " + int_to_string(lineNumber);
                    } else if (gen2RirStarts(line, "store_ref ") && gen2RirFind(line, ", ") < 0) {
                        return "malformed store_ref at RIR line " + int_to_string(lineNumber);
                    }
                } else if (gen2RirStarts(line, "function ")) {
                    if (gen2RirFind(line, "(") < 0 || gen2RirFind(line, ") -> ") < 0) {
                        return "malformed function header at RIR line " + int_to_string(lineNumber);
                    }
                    inFunction = true;
                    hasFunction = true;
                    lastWasStruct = false;
                } else if (gen2RirStarts(line, "use-quoted ")) {
                    if (length(line) <= 11) return "empty native include at RIR line " + int_to_string(lineNumber);
                    lastWasStruct = false;
                } else if (gen2RirStarts(line, "global ") || gen2RirStarts(line, "global-auto ") ||
                    gen2RirStarts(line, "global-const ") || gen2RirStarts(line, "global-const-auto ")) {
                    lastWasStruct = false;
                } else if (gen2RirStarts(line, "struct ")) {
                    if (length(line) <= 7) return "empty struct name at RIR line " + int_to_string(lineNumber);
                    lastWasStruct = true;
                } else if (gen2RirStarts(line, "field ") && lastWasStruct) {
                    lastWasStruct = true;
                } else {
                    return "unexpected RIR declaration at line " + int_to_string(lineNumber) + ": " + line;
                }
            }
        }
        i = i + 1;
        if (i == length(rir) || (i < length(rir) && charCodeAt(rir, i) == 10)) lineNumber = lineNumber + 1;
    }

    if (inFunction) return "unterminated RIR function (missing endfunction)";
    if (!hasFunction) return "RIR module has no functions";
    return "";
}
