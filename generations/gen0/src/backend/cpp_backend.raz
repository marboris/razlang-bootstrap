// Experimental Raz backend: RIR text -> C++17 text.
// The backend accepts the RIR-1 subset produced by the native frontend.

struct FunctionMeta {
    name: string;
    params: List<string>;
    paramTypes: List<string>;
    returnType: string;
    body: List<string>;
}

struct StructMeta {
    name: string;
    fields: List<string>;
    fieldTypes: List<string>;
}

struct BackendModule {
    structs: List<StructMeta>;
    functions: List<FunctionMeta>;
}

struct BackendState {
    lines: List<string>;
    temps: List<string>;
    tempTypes: List<string>;
    locals: List<string>;
    localTypes: List<string>;
    aliasNames: List<string>;
    aliasValues: List<string>;
}

function trim(s: string) -> string {
    let a: i64 = 0;
    let b: i64 = length(s);
    while (a < b && (s[a] == 32 || s[a] == 9)) a = a + 1;
    while (b > a && (s[b - 1] == 32 || s[b - 1] == 9)) b = b - 1;
    return slice(s, a, b);
}

function starts(s: string, prefix: string) -> bool {
    if (length(s) < length(prefix)) return false;
    return slice(s, 0, length(prefix)) == prefix;
}

function findText(s: string, needle: string, from: i64) -> i64 {
    let n: i64 = length(needle);
    let i: i64 = from;
    if (n == 0) return from;
    while (i + n <= length(s)) {
        if (slice(s, i, i + n) == needle) return i;
        i = i + 1;
    }
    return -1;
}

function splitLines(s: string) -> List<string> {
    let out: List<string> = [];
    let start: i64 = 0;
    let i: i64 = 0;
    while (i < length(s)) {
        if (s[i] == 10) {
            push(out, slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < length(s)) push(out, slice(s, start, length(s)));
    return out;
}

function afterArrow(s: string) -> string {
    let p: i64 = findText(s, "->", 0);
    if (p < 0) return "void";
    return trim(slice(s, p + 2, length(s)));
}

function addParam(f: Ref<FunctionMeta>, item: string) {
    let x: string = trim(item);
    if (x == "") return;
    let p: i64 = findText(x, " ", 0);
    if (p < 0) return;
    push(f.paramTypes, trim(slice(x, 0, p)));
    push(f.params, trim(slice(x, p + 1, length(x))));
}

function parseFunction(line: string) -> FunctionMeta {
    let f: FunctionMeta = new FunctionMeta();
    f.params = [];
    f.paramTypes = [];
    f.body = [];
    let open: i64 = findText(line, "(", 0);
    let close: i64 = findText(line, ")", open + 1);
    if (open < 0 || close < 0) return f;
    f.name = trim(slice(line, 9, open));
    let raw: string = slice(line, open + 1, close);
    let start: i64 = 0;
    let i: i64 = 0;
    while (i <= length(raw)) {
        if (i == length(raw) || raw[i] == 44) {
            addParam(f, slice(raw, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    f.returnType = afterArrow(line);
    return f;
}

function parseRir(rir: string) -> BackendModule {
    let lines: List<string> = splitLines(rir);
    let module: BackendModule = new BackendModule();
    module.structs = [];
    module.functions = [];
    let i: i64 = 1;
    while (i < listLength(lines)) {
        let line: string = trim(lines[i]);
        if (line == "" || line == "rir 1") {
            i = i + 1;
        } else if (starts(line, "struct ")) {
            let st: StructMeta = new StructMeta();
            st.name = trim(slice(line, 7, length(line)));
            st.fields = [];
            st.fieldTypes = [];
            i = i + 1;
            while (i < listLength(lines) && starts(trim(lines[i]), "field ")) {
                let fieldLine: string = trim(lines[i]);
                let rest: string = trim(slice(fieldLine, 6, length(fieldLine)));
                let p: i64 = findText(rest, " ", 0);
                if (p >= 0) {
                    push(st.fieldTypes, trim(slice(rest, 0, p)));
                    push(st.fields, trim(slice(rest, p + 1, length(rest))));
                }
                i = i + 1;
            }
            push(module.structs, st);
        } else if (starts(line, "function ")) {
            let f: FunctionMeta = parseFunction(line);
            i = i + 1;
            while (i < listLength(lines) && trim(lines[i]) != "endfunction") {
                let bodyLine: string = trim(lines[i]);
                if (bodyLine != "") push(f.body, bodyLine);
                i = i + 1;
            }
            if (i < listLength(lines)) i = i + 1;
            push(module.functions, f);
        } else {
            i = i + 1;
        }
    }
    return module;
}

function cppType(t: string) -> string {
    if (t == "i64") return "std::int64_t";
    if (t == "f64") return "double";
    if (t == "bool") return "bool";
    if (t == "string") return "std::string";
    if (starts(t, "List<")) {
        let inner: string = slice(t, 5, length(t) - 1);
        return "std::vector<" + cppType(inner) + ">";
    }
    if (starts(t, "Ref<")) {
        let inner: string = slice(t, 4, length(t) - 1);
        return cppType(inner) + "&";
    }
    return t;
}

function cppName(name: string) -> string {
    if (name == "main") return "raz_main";
    if (name == "print") return "raz::print";
    if (name == "readFile") return "raz::read_file";
    if (name == "writeFile") return "raz::write_file";
    if (name == "length") return "raz::string_length";
    if (name == "slice") return "raz::string_slice";
    if (name == "append") return "raz::list_append";
    if (name == "push") return "raz::list_push";
    if (name == "listLength") return "raz::list_length";
    if (name == "int_to_string") return "raz::int_to_string";
    return name;
}

function valueName(v: string) -> string {
    let x: string = trim(v);
    if (starts(x, "%")) return "t" + slice(x, 1, length(x));
    return x;
}

function cppValue(state: Ref<BackendState>, value: string) -> string {
    let x: string = trim(value);
    if (!starts(x, "%")) return x;
    let name: string = valueName(x);
    let i: i64 = 0;
    while (i < listLength(state.aliasNames)) {
        if (state.aliasNames[i] == name) return state.aliasValues[i];
        i = i + 1;
    }
    return name;
}

function setAlias(state: Ref<BackendState>, name: string, value: string) {
    let i: i64 = 0;
    while (i < listLength(state.aliasNames)) {
        if (state.aliasNames[i] == name) {
            state.aliasValues[i] = value;
            return;
        }
        i = i + 1;
    }
    push(state.aliasNames, name);
    push(state.aliasValues, value);
}

function cppArgs(state: Ref<BackendState>, values: string) -> string {
    let out: string = "";
    let start: i64 = 0;
    let i: i64 = 0;
    while (i <= length(values)) {
        if (i == length(values) || values[i] == 44) {
            let item: string = trim(slice(values, start, i));
            if (item != "") {
                if (out != "") out = out + ", ";
                out = out + cppValue(state, item);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

function has(state: Ref<BackendState>, name: string) -> bool {
    let i: i64 = 0;
    while (i < listLength(state.temps)) {
        if (state.temps[i] == name) return true;
        i = i + 1;
    }
    return false;
}

function localIndex(state: Ref<BackendState>, name: string) -> i64 {
    let i: i64 = 0;
    while (i < listLength(state.locals)) {
        if (state.locals[i] == name) return i;
        i = i + 1;
    }
    return -1;
}

function addTemp(state: Ref<BackendState>, name: string, type: string) {
    if (name == "" || has(state, name)) return;
    push(state.temps, name);
    push(state.tempTypes, type);
}

function tempType(state: Ref<BackendState>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(state.temps)) {
        if (state.temps[i] == name) return state.tempTypes[i];
        i = i + 1;
    }
    return "i64";
}

function setTempType(state: Ref<BackendState>, name: string, type: string) {
    let i: i64 = 0;
    while (i < listLength(state.temps)) {
        if (state.temps[i] == name) {
            state.tempTypes[i] = type;
            return;
        }
        i = i + 1;
    }
}

function refineListType(state: Ref<BackendState>, value: string, expected: string) {
    let x: string = trim(value);
    if (!starts(x, "%") || !starts(expected, "List<")) return;
    let name: string = valueName(x);
    if (tempType(state, name) == "List<i64>") setTempType(state, name, expected);
}

function findVarType(f: Ref<FunctionMeta>, state: Ref<BackendState>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(f.params)) {
        if (f.params[i] == name) return f.paramTypes[i];
        i = i + 1;
    }
    i = 0;
    while (i < listLength(state.locals)) {
        if (state.locals[i] == name) return state.localTypes[i];
        i = i + 1;
    }
    return "i64";
}

function valueType(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>, value: string) -> string {
    let x: string = trim(value);
    if (starts(x, "%")) {
        return tempType(state, valueName(x));
    }
    if (x == "true" || x == "false") return "bool";
    if (starts(x, "\"")) return "string";
    return findVarType(f, state, x);
}

function functionReturnType(module: Ref<BackendModule>, name: string) -> string {
    let i: i64 = 0;
    while (i < listLength(module.functions)) {
        if (module.functions[i].name == name) return module.functions[i].returnType;
        i = i + 1;
    }
    if (name == "readFile" || name == "slice" || name == "int_to_string") return "string";
    if (name == "length" || name == "listLength") return "i64";
    if (name == "print" || name == "writeFile" || name == "push") return "void";
    return "i64";
}

function structFieldType(module: Ref<BackendModule>, type: string, field: string) -> string {
    let name: string = type;
    if (starts(name, "Ref<")) name = slice(name, 4, length(name) - 1);
    let generic: i64 = findText(name, "<", 0);
    if (generic >= 0) name = slice(name, 0, generic);
    let i: i64 = 0;
    while (i < listLength(module.structs)) {
        let st: StructMeta = module.structs[i];
        if (st.name == name) {
            let j: i64 = 0;
            while (j < listLength(st.fields)) {
                if (st.fields[j] == field) return st.fieldTypes[j];
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "i64";
}

function inferRhsType(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>, rhs: string) -> string {
    if (starts(rhs, "ref ")) {
        let type: string = findVarType(f, state, trim(slice(rhs, 4, length(rhs))));
        if (starts(type, "Ref<")) return type;
        return "Ref<" + type + ">";
    }
    if (starts(rhs, "ref_field ")) {
        let rest: string = trim(slice(rhs, 10, length(rhs)));
        let dot: i64 = findText(rest, ".", 0);
        if (dot >= 0) {
            let base: string = valueType(module, f, state, slice(rest, 0, dot));
            return "Ref<" + structFieldType(module, base, trim(slice(rest, dot + 1, length(rest)))) + ">";
        }
    }
    if (starts(rhs, "ref_index ")) {
        let rest: string = trim(slice(rhs, 10, length(rhs)));
        let open: i64 = findText(rest, "[", 0);
        if (open >= 0) {
            let base: string = valueType(module, f, state, slice(rest, 0, open));
            if (starts(base, "Ref<")) base = slice(base, 4, length(base) - 1);
            if (starts(base, "List<")) return "Ref<" + slice(base, 5, length(base) - 1) + ">";
        }
    }
    if (starts(rhs, "const ")) {
        let rest: string = trim(slice(rhs, 6, length(rhs)));
        let p: i64 = findText(rest, " ", 0);
        if (p >= 0) return trim(slice(rest, 0, p));
    }
    if (starts(rhs, "load ")) return findVarType(f, state, trim(slice(rhs, 5, length(rhs))));
    if (starts(rhs, "new ")) {
        let rest: string = trim(slice(rhs, 4, length(rhs)));
        let p: i64 = findText(rest, "(", 0);
        if (p >= 0) return trim(slice(rest, 0, p));
        return rest;
    }
    if (starts(rhs, "field ")) {
        let rest: string = trim(slice(rhs, 6, length(rhs)));
        let dot: i64 = findText(rest, ".", 0);
        if (dot >= 0) return structFieldType(module, valueType(module, f, state, slice(rest, 0, dot)), trim(slice(rest, dot + 1, length(rest))));
    }
    if (starts(rhs, "index ")) {
        let rest: string = trim(slice(rhs, 6, length(rhs)));
        let open: i64 = findText(rest, "[", 0);
        if (open >= 0) {
            let base: string = valueType(module, f, state, slice(rest, 0, open));
            let sequence: string = base;
            if (starts(sequence, "Ref<")) sequence = slice(sequence, 4, length(sequence) - 1);
            if (starts(sequence, "List<")) return slice(sequence, 5, length(sequence) - 1);
            if (base == "string") return "i64";
        }
    }
    if (starts(rhs, "list(")) {
        let rest: string = slice(rhs, 5, length(rhs) - 1);
        let comma: i64 = findText(rest, ",", 0);
        if (comma < 0) return "List<i64>";
        return "List<" + valueType(module, f, state, slice(rest, 0, comma)) + ">";
    }
    if (starts(rhs, "call ")) {
        let rest: string = trim(slice(rhs, 5, length(rhs)));
        let open: i64 = findText(rest, "(", 0);
        if (open >= 0) {
            let name: string = trim(slice(rest, 0, open));
            if (name == "append") {
                let args: string = slice(rest, open + 1, length(rest) - 1);
                let comma: i64 = findText(args, ",", 0);
                if (comma >= 0) return valueType(module, f, state, slice(args, 0, comma));
            }
            return functionReturnType(module, name);
        }
    }
    let space: i64 = findText(rhs, " ", 0);
    if (space >= 0) {
        let op: string = slice(rhs, 0, space);
        if (op == "eq" || op == "ne" || op == "lt" || op == "le" || op == "gt" || op == "ge" || op == "and" || op == "or" || op == "not") return "bool";
        if (op == "add" || op == "sub" || op == "mul" || op == "div" || op == "mod" || op == "neg" || op == "pos") {
            let rest: string = trim(slice(rhs, space + 1, length(rhs)));
            let comma: i64 = findText(rest, ",", 0);
            let left: string = trim(slice(rest, 0, comma));
            let leftType: string = valueType(module, f, state, left);
            if (op == "add" && leftType == "string") return "string";
            return leftType;
        }
    }
    return "i64";
}

function collectDeclarations(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>) {
    state.temps = [];
    state.tempTypes = [];
    state.locals = [];
    state.localTypes = [];
    state.aliasNames = [];
    state.aliasValues = [];

    let i: i64 = 0;
    while (i < listLength(f.body)) {
        let line: string = trim(f.body[i]);
        if (starts(line, "local ")) {
            let local: string = trim(slice(line, 6, length(line)));
            let split: i64 = findText(local, " ", 0);
            if (split >= 0) {
                let type: string = trim(slice(local, 0, split));
                let name: string = trim(slice(local, split + 1, length(local)));
                if (localIndex(state, name) < 0) {
                    push(state.localTypes, type);
                    push(state.locals, name);
                }
            }
        }
        i = i + 1;
    }

    i = 0;
    while (i < listLength(f.body)) {
        let line: string = trim(f.body[i]);
        let split: i64 = findText(line, " = ", 0);
        if (starts(line, "%") && split > 2) {
            let name: string = valueName(trim(slice(line, 0, split)));
            let rhs: string = trim(slice(line, split + 3, length(line)));
            addTemp(state, name, inferRhsType(module, f, state, rhs));
        }
        i = i + 1;
    }

    i = 0;
    while (i < listLength(f.body)) {
        let line: string = trim(f.body[i]);
        if (starts(line, "store ")) {
            let store: string = slice(line, 6, length(line));
            let comma: i64 = findText(store, ",", 0);
            if (comma >= 0) {
                let local: string = trim(slice(store, 0, comma));
                let value: string = trim(slice(store, comma + 1, length(store)));
                refineListType(state, value, findVarType(f, state, local));
            }
        } else if (starts(line, "field_set ")) {
            let fieldSet: string = slice(line, 10, length(line));
            let eq: i64 = findText(fieldSet, " = ", 0);
            if (eq >= 0) {
                let target: string = trim(slice(fieldSet, 0, eq));
                let dot: i64 = findText(target, ".", 0);
                if (dot >= 0) {
                    let base: string = trim(slice(target, 0, dot));
                    let field: string = trim(slice(target, dot + 1, length(target)));
                    let expected: string = structFieldType(module, findVarType(f, state, base), field);
                    refineListType(state, trim(slice(fieldSet, eq + 3, length(fieldSet))), expected);
                }
            }
        } else if (starts(line, "store_ref ")) {
            let refStore: string = slice(line, 10, length(line));
            let comma: i64 = findText(refStore, ",", 0);
            if (comma >= 0) {
                let ref: string = valueName(trim(slice(refStore, 0, comma)));
                let refType: string = tempType(state, ref);
                if (starts(refType, "Ref<") && length(refType) > 5) {
                    let expected: string = slice(refType, 4, length(refType) - 1);
                    refineListType(state, trim(slice(refStore, comma + 1, length(refStore))), expected);
                }
            }
        }
        i = i + 1;
    }
}

function emitLine(state: Ref<BackendState>, line: string) {
    push(state.lines, line);
}

function resetLines(state: Ref<BackendState>) {
    state.lines = [];
}

function cppLiteral(rest: string, type: string) -> string {
    if (type == "string") return "std::string(" + rest + ")";
    if (type == "bool") return rest;
    if (type == "char") return "'" + rest + "'";
    return rest;
}

function emitFunction(module: Ref<BackendModule>, f: Ref<FunctionMeta>, state: Ref<BackendState>) {
    collectDeclarations(module, f, state);
    let params: string = "";
    let i: i64 = 0;
    while (i < listLength(f.params)) {
        if (i > 0) params = params + ", ";
        params = params + cppType(f.paramTypes[i]) + " " + f.params[i];
        i = i + 1;
    }

    emitLine(state, cppType(f.returnType) + " " + cppName(f.name) + "(" + params + ") {");
    i = 0;
    while (i < listLength(state.locals)) {
        emitLine(state, "    " + cppType(state.localTypes[i]) + " " + state.locals[i] + "{};");
        i = i + 1;
    }
    i = 0;
    while (i < listLength(state.temps)) {
        if (!starts(state.tempTypes[i], "Ref<")) emitLine(state, "    " + cppType(state.tempTypes[i]) + " " + state.temps[i] + "{};");
        i = i + 1;
    }
    emitLine(state, "");

    i = 0;
    while (i < listLength(f.body)) {
        let line: string = trim(f.body[i]);
        if (line == "") {
            i = i + 1;
        } else {
        let p: i64 = findText(line, " = ", 0);
        if (line == "entry:") {
            emitLine(state, "entry:;");
        } else if (line[length(line) - 1] == 58) {
            emitLine(state, line + ";");
        } else if (starts(line, "local ")) {
        } else if (starts(line, "store ")) {
            let x: string = slice(line, 6, length(line));
            let c: i64 = findText(x, ",", 0);
            emitLine(state, "    " + trim(slice(x, 0, c)) + " = " + cppValue(state, trim(slice(x, c + 1, length(x)))) + ";");
        } else if (starts(line, "store_ref ")) {
            let x: string = slice(line, 10, length(line));
            let c: i64 = findText(x, ",", 0);
            emitLine(state, "    " + cppValue(state, trim(slice(x, 0, c))) + " = " + cppValue(state, trim(slice(x, c + 1, length(x)))) + ";");
        } else if (starts(line, "jump ")) {
            emitLine(state, "    goto " + trim(slice(line, 5, length(line))) + ";");
        } else if (starts(line, "branch ")) {
            let x: string = slice(line, 7, length(line));
            let q: i64 = findText(x, " ? ", 0);
            let c: i64 = findText(x, " : ", q + 3);
            emitLine(state, "    if (" + cppValue(state, trim(slice(x, 0, q))) + ") goto " + trim(slice(x, q + 3, c)) + "; else goto " + trim(slice(x, c + 3, length(x))) + ";");
        } else if (starts(line, "return")) {
            let x: string = trim(slice(line, 6, length(line)));
            if (x == "") emitLine(state, "    return;");
            else emitLine(state, "    return " + cppValue(state, x) + ";");
        } else if (starts(line, "call ")) {
            let call: string = trim(slice(line, 5, length(line)));
            let open: i64 = findText(call, "(", 0);
            let callee: string = trim(slice(call, 0, open));
            let args: string = slice(call, open + 1, length(call) - 1);
            emitLine(state, "    " + cppName(callee) + "(" + cppArgs(state, args) + ");");
        } else if (p > 2 && starts(line, "%t")) {
            let lhs: string = valueName(trim(slice(line, 0, p)));
            let rhs: string = trim(slice(line, p + 3, length(line)));
            if (starts(rhs, "const ")) {
                let rest: string = slice(rhs, 6, length(rhs));
                let sp: i64 = findText(rest, " ", 0);
                let typ: string = trim(slice(rest, 0, sp));
                let val: string = trim(slice(rest, sp + 1, length(rest)));
                emitLine(state, "    " + lhs + " = " + cppLiteral(val, typ) + ";");
            } else if (starts(rhs, "load ")) {
                let name: string = trim(slice(rhs, 5, length(rhs)));
                if (starts(tempType(state, lhs), "Ref<")) setAlias(state, lhs, name);
                else emitLine(state, "    " + lhs + " = " + cppValue(state, name) + ";");
            } else if (starts(rhs, "ref ")) {
                setAlias(state, lhs, trim(slice(rhs, 4, length(rhs))));
            } else if (starts(rhs, "ref_field ")) {
                let z: string = trim(slice(rhs, 10, length(rhs)));
                let dot: i64 = findText(z, ".", 0);
                setAlias(state, lhs, cppValue(state, trim(slice(z, 0, dot))) + "." + trim(slice(z, dot + 1, length(z))));
            } else if (starts(rhs, "ref_index ")) {
                let z: string = trim(slice(rhs, 10, length(rhs)));
                let open: i64 = findText(z, "[", 0);
                setAlias(state, lhs, cppValue(state, trim(slice(z, 0, open))) + "[" + cppValue(state, trim(slice(z, open + 1, length(z) - 1))) + "]");
            } else if (starts(rhs, "new ")) {
                emitLine(state, "    " + lhs + " = " + trim(slice(rhs, 4, length(rhs))) + "{};" );
            } else if (starts(rhs, "field ")) {
                let z: string = trim(slice(rhs, 6, length(rhs)));
                let dot: i64 = findText(z, ".", 0);
                emitLine(state, "    " + lhs + " = " + cppValue(state, trim(slice(z, 0, dot))) + "." + trim(slice(z, dot + 1, length(z))) + ";");
            } else if (starts(rhs, "index ")) {
                let z: string = trim(slice(rhs, 6, length(rhs)));
                let open: i64 = findText(z, "[", 0);
                emitLine(state, "    " + lhs + " = " + cppValue(state, trim(slice(z, 0, open))) + "[" + cppValue(state, trim(slice(z, open + 1, length(z) - 1))) + "];" );
            } else if (starts(rhs, "call ")) {
                let z: string = slice(rhs, 5, length(rhs));
                let open: i64 = findText(z, "(", 0);
                let callee: string = trim(slice(z, 0, open));
                let args: string = slice(z, open + 1, length(z) - 1);
                let aa: string = cppArgs(state, args);
                emitLine(state, "    " + lhs + " = " + cppName(callee) + "(" + aa + ");");
            } else if (starts(rhs, "list(")) {
                let z: string = slice(rhs, 5, length(rhs) - 1);
                let aa: string = cppArgs(state, z);
                emitLine(state, "    " + lhs + " = " + cppType(tempType(state, lhs)) + "{" + aa + "};");
            } else {
                let op: string = "";
                let symbol: string = "";
                if (starts(rhs, "add ")) { op = "add"; symbol = "+"; }
                else if (starts(rhs, "sub ")) { op = "sub"; symbol = "-"; }
                else if (starts(rhs, "mul ")) { op = "mul"; symbol = "*"; }
                else if (starts(rhs, "div ")) { op = "div"; symbol = "/"; }
                else if (starts(rhs, "mod ")) { op = "mod"; symbol = "%"; }
                else if (starts(rhs, "eq ")) { op = "eq"; symbol = "=="; }
                else if (starts(rhs, "ne ")) { op = "ne"; symbol = "!="; }
                else if (starts(rhs, "lt ")) { op = "lt"; symbol = "<"; }
                else if (starts(rhs, "le ")) { op = "le"; symbol = "<="; }
                else if (starts(rhs, "gt ")) { op = "gt"; symbol = ">"; }
                else if (starts(rhs, "ge ")) { op = "ge"; symbol = ">="; }
                else if (starts(rhs, "and ")) { op = "and"; symbol = "&&"; }
                else if (starts(rhs, "or ")) { op = "or"; symbol = "||"; }
                else if (starts(rhs, "neg ")) { op = "neg"; symbol = "~"; }
                else if (starts(rhs, "not ")) { op = "not"; symbol = "!"; }
                else if (starts(rhs, "pos ")) { op = "pos"; symbol = "+"; }
                if (op == "neg") {
                    emitLine(state, "    " + lhs + " = -" + cppValue(state, trim(slice(rhs, 4, length(rhs))) ) + ";");
                } else if (op == "not" || op == "pos") {
                    emitLine(state, "    " + lhs + " = " + symbol + cppValue(state, trim(slice(rhs, length(op) + 1, length(rhs)))) + ";");
                } else if (op != "") {
                    let z: string = slice(rhs, length(op) + 1, length(rhs));
                    let comma: i64 = findText(z, ",", 0);
                    let a: string = cppValue(state, trim(slice(z, 0, comma)));
                    let b: string = cppValue(state, trim(slice(z, comma + 1, length(z))));
                    emitLine(state, "    " + lhs + " = " + a + " " + symbol + " " + b + ";");
                }
            }
        } else if (starts(line, "field_set ")) {
            let x: string = slice(line, 10, length(line));
            let eq: i64 = findText(x, " = ", 0);
            emitLine(state, "    " + trim(slice(x, 0, eq)) + " = " + cppValue(state, trim(slice(x, eq + 3, length(x)))) + ";");
        }
        i = i + 1;
        }
    }
    emitLine(state, "}");
    emitLine(state, "");
}

function generate(rir: string) -> string {
    let module: BackendModule = parseRir(rir);
    let state: BackendState = new BackendState();
    state.lines = [];

    emitLine(state, "#include <cstdint>");
    emitLine(state, "#include <cstddef>");
    emitLine(state, "#include <string>");
    emitLine(state, "#include <vector>");
    emitLine(state, "#include \"raz_runtime.hpp\"");
    emitLine(state, "");

    let i: i64 = 0;
    while (i < listLength(module.structs)) {
        let st: StructMeta = module.structs[i];
        emitLine(state, "struct " + st.name + " {");
        let j: i64 = 0;
        while (j < listLength(st.fields)) {
            emitLine(state, "    " + cppType(st.fieldTypes[j]) + " " + st.fields[j] + "{};");
            j = j + 1;
        }
        emitLine(state, "};");
        emitLine(state, "");
        i = i + 1;
    }

    i = 0;
    while (i < listLength(module.functions)) {
        let f: FunctionMeta = module.functions[i];
        let params: string = "";
        let j: i64 = 0;
        while (j < listLength(f.params)) {
            if (j > 0) params = params + ", ";
            params = params + cppType(f.paramTypes[j]) + " " + f.params[j];
            j = j + 1;
        }
        emitLine(state, cppType(f.returnType) + " " + cppName(f.name) + "(" + params + ");");
        i = i + 1;
    }
    emitLine(state, "");

    i = 0;
    while (i < listLength(module.functions)) {
        emitFunction(module, module.functions[i], state);
        i = i + 1;
    }

    emitLine(state, "int main() {");
    emitLine(state, "    return static_cast<int>(raz_main());");
    emitLine(state, "}");

    let out: string = "";
    i = 0;
    while (i < listLength(state.lines)) {
        out = out + state.lines[i] + "\n";
        i = i + 1;
    }
    return out;
}

function main() -> i64 {
    let rir: string = readFile("backend/input.rir");
    if (rir == "") return 1;
    let cpp: string = generate(rir);
    if (cpp == "") return 1;
    writeFile("backend/output.cpp", cpp);
    return 0;
}
