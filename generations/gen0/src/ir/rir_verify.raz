// RIR-1 structural parser and verifier, written in Raz.
//
// The purpose of this stage is to make the textual IR a real compiler
// contract instead of an informal string convention used by the backend.
//
// Input:  ir/input.rir
// Output: ir/verification.txt
// Return value: 0 when valid, 1 when invalid.

struct RirFunction {
    name: string;
    returnType: string;
    params: List<string>;
    blocks: List<string>;
    lines: List<string>;
}

struct VerifyState {
    ok: bool;
    message: string;
    functions: List<string>;
    labels: List<string>;
    defs: List<string>;
    knownNames: List<string>;
    targets: List<string>;
    currentFunction: string;
}

function trim(s: string) -> string {
    let a: i64 = 0;
    let b: i64 = length(s);
    while (a < b && (s[a] == 32 || s[a] == 9 || s[a] == 13)) a = a + 1;
    while (b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 13)) b = b - 1;
    return slice(s, a, b);
}

function starts(s: string, prefix: string) -> bool {
    if (length(s) < length(prefix)) return false;
    return slice(s, 0, length(prefix)) == prefix;
}

function findText(s: string, needle: string, from: i64) -> i64 {
    let n: i64 = length(needle);
    let i: i64 = from;
    if (n == 0) return from;
    while (i + n <= length(s)) {
        if (slice(s, i, i + n) == needle) return i;
        i = i + 1;
    }
    return -1;
}

function splitLines(s: string) -> List<string> {
    let out: List<string> = [];
    let start: i64 = 0;
    let i: i64 = 0;
    while (i < length(s)) {
        if (s[i] == 10) {
            push(out, slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < length(s)) push(out, slice(s, start, length(s)));
    return out;
}

function contains(xs: List<string>, value: string) -> bool {
    let i: i64 = 0;
    while (i < listLength(xs)) {
        if (xs[i] == value) return true;
        i = i + 1;
    }
    return false;
}

function addUnique(xs: Ref<List<string>>, value: string) -> bool {
    if (contains(xs, value)) return false;
    push(xs, value);
    return true;
}

function fail(state: Ref<VerifyState>, message: string) {
    if (state.ok) {
        state.ok = false;
        state.message = message;
    }
}

function parseTypeFromConst(rhs: string) -> string {
    if (!starts(rhs, "const ")) return "";
    let rest: string = slice(rhs, 6, length(rhs));
    let p: i64 = findText(rest, " ", 0);
    if (p < 0) return "";
    return trim(slice(rest, 0, p));
}

function resultName(line: string) -> string {
    if (length(line) < 4 || line[0] != 37) return "";
    let p: i64 = findText(line, " = ", 0);
    if (p < 2) return "";
    return slice(line, 0, p);
}

function operandRefs(text: string) -> List<string> {
    let out: List<string> = [];
    let i: i64 = 0;
    let start: i64 = -1;
    while (i < length(text)) {
        let c: i64 = text[i];
        let isRef: bool = c == 37;
        if (isRef) {
            start = i;
            i = i + 1;
            let keep: bool = true;
            while (i < length(text) && keep) {
                let d: i64 = text[i];
                if ((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                } else {
                    keep = false;
                }
            }
            if (start >= 0) push(out, slice(text, start, i));
            start = -1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

function markParams(state: Ref<VerifyState>, signature: string) {
    let open: i64 = findText(signature, "(", 0);
    let close: i64 = findText(signature, ")", open + 1);
    if (open < 0 || close < 0) {
        fail(state, "malformed function signature");
        return;
    }
    let raw: string = slice(signature, open + 1, close);
    let start: i64 = 0;
    let i: i64 = 0;
    while (i <= length(raw)) {
        if (i == length(raw) || raw[i] == 44) {
            let item: string = trim(slice(raw, start, i));
            if (item != "") {
                let sp: i64 = findText(item, " ", 0);
                if (sp < 0) {
                    fail(state, "malformed function parameter");
                    return;
                }
                let name: string = trim(slice(item, sp + 1, length(item)));
                if (name == "") {
                    fail(state, "empty function parameter name");
                    return;
                }
                if (!addUnique(state.knownNames, name)) {
                    fail(state, "duplicate function parameter " + name);
                    return;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

function checkOperandDefs(state: Ref<VerifyState>, line: string) {
    let refs: List<string> = operandRefs(line);
    let i: i64 = 0;
    while (i < listLength(refs)) {
        if (!contains(state.defs, refs[i])) {
            fail(state, "use of undefined value " + refs[i]);
            return;
        }
        i = i + 1;
    }
}

function checkInstruction(state: Ref<VerifyState>, line: string) {
    if (line == "") return;
    if (line[0] == 32 || line[0] == 9) {
        fail(state, "instruction text must be trimmed before verification");
        return;
    }

    if (endsWith(line, ":")) {
        let label: string = trim(slice(line, 0, length(line) - 1));
        if (label == "") {
            fail(state, "empty basic-block label");
            return;
        }
        if (!addUnique(state.labels, label)) {
            fail(state, "duplicate label " + label);
            return;
        }
        return;
    }

    let result: string = resultName(line);
    if (result != "") {
        if (contains(state.defs, result)) {
            fail(state, "duplicate SSA value " + result);
            return;
        }
        push(state.defs, result);
    }

    if (starts(line, "local ")) {
        let rest: string = trim(slice(line, 6, length(line)));
        let sp: i64 = findText(rest, " ", 0);
        if (sp < 0) {
            fail(state, "malformed local instruction");
            return;
        }
        let type: string = trim(slice(rest, 0, sp));
        let name: string = trim(slice(rest, sp + 1, length(rest)));
        if (type == "" || name == "") {
            fail(state, "malformed local instruction");
            return;
        }
        if (!addUnique(state.knownNames, name)) fail(state, "duplicate local " + name);
        return;
    }

    if (starts(line, "store ")) {
        let comma: i64 = findText(line, ", ", 6);
        if (comma < 0) fail(state, "malformed store instruction");
        else checkOperandDefs(state, slice(line, comma + 2, length(line)));
        return;
    }

    if (starts(line, "field_set ")) {
        let eq: i64 = findText(line, " = ", 10);
        if (eq < 0) fail(state, "malformed field_set instruction");
        else checkOperandDefs(state, slice(line, eq + 3, length(line)));
        return;
    }

    if (starts(line, "index_set ")) {
        let eq: i64 = findText(line, " = ", 10);
        if (eq < 0) fail(state, "malformed index_set instruction");
        else checkOperandDefs(state, slice(line, eq + 3, length(line)));
        return;
    }

    if (starts(line, "return")) {
        if (line == "return") return;
        if (starts(line, "return ")) checkOperandDefs(state, slice(line, 7, length(line)));
        else fail(state, "malformed return instruction");
        return;
    }

    if (starts(line, "call ") || starts(line, "builtin ")) {
        checkOperandDefs(state, line);
        return;
    }

    if (starts(line, "jump ")) {
        let target: string = trim(slice(line, 5, length(line)));
        if (target == "") fail(state, "jump requires a target");
        else push(state.targets, target);
        return;
    }

    if (starts(line, "branch ")) {
        let q: i64 = findText(line, " ? ", 7);
        let c: i64 = findText(line, " : ", q + 3);
        if (q < 0 || c < 0) {
            fail(state, "malformed branch instruction");
            return;
        }
        checkOperandDefs(state, slice(line, 7, q));
        let thenTarget: string = trim(slice(line, q + 3, c));
        let elseTarget: string = trim(slice(line, c + 3, length(line)));
        if (thenTarget == "" || elseTarget == "") {
            fail(state, "branch requires two targets");
            return;
        }
        push(state.targets, thenTarget);
        push(state.targets, elseTarget);
        return;
    }

    if (result == "") {
        fail(state, "unknown RIR instruction " + line);
        return;
    }

    let eq: i64 = findText(line, " = ", 0);
    if (eq < 0) {
        fail(state, "malformed value-producing instruction");
        return;
    }
    let rhs: string = trim(slice(line, eq + 3, length(line)));
    if (starts(rhs, "ref ")) {
        let name: string = trim(slice(rhs, 4, length(rhs)));
        if (name == "") fail(state, "ref requires a name");
        return;
    }
    if (starts(rhs, "ref_field ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "ref_index ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "const ")) {
        if (parseTypeFromConst(rhs) == "") fail(state, "const requires a type");
        return;
    }
    if (starts(rhs, "load ")) return;
    if (starts(rhs, "field ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "index ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "new ")) return;
    if (starts(rhs, "list(")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "call ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "builtin ") || starts(rhs, "intrinsic ")) {
        checkOperandDefs(state, rhs);
        return;
    }
    if (starts(rhs, "add ") || starts(rhs, "sub ") || starts(rhs, "mul ") || starts(rhs, "div ") || starts(rhs, "mod ") || starts(rhs, "eq ") || starts(rhs, "ne ") || starts(rhs, "lt ") || starts(rhs, "le ") || starts(rhs, "gt ") || starts(rhs, "ge ") || starts(rhs, "and ") || starts(rhs, "or ") || starts(rhs, "neg ") || starts(rhs, "not ") || starts(rhs, "pos ")) {
        checkOperandDefs(state, rhs);
        return;
    }

    fail(state, "unknown RIR value operation " + rhs);
}

function endsWith(s: string, suffix: string) -> bool {
    if (length(s) < length(suffix)) return false;
    return slice(s, length(s) - length(suffix), length(s)) == suffix;
}

function verifyRir(rir: string, state: Ref<VerifyState>) -> i64 {
    state.ok = true;
    state.message = "";
    state.functions = [];
    state.labels = [];
    state.defs = [];
    state.knownNames = [];
    state.targets = [];
    state.currentFunction = "";

    let lines: List<string> = splitLines(rir);
    if (listLength(lines) == 0 || trim(lines[0]) != "rir 1") {
        fail(state, "RIR header must be 'rir 1'");
        return 1;
    }

    let inFunction: bool = false;
    let inStruct: bool = false;
    let functionCount: i64 = 0;
    let i: i64 = 1;

    while (i < listLength(lines) && state.ok) {
        let raw: string = lines[i];
        let line: string = trim(raw);

        if (line == "") {
            i = i + 1;
        } else {
            if (inStruct && !starts(line, "field ")) inStruct = false;

            if (starts(line, "struct ")) {
                if (inFunction) {
                    fail(state, "struct declaration inside function");
                } else {
                    inStruct = true;
                    i = i + 1;
                }
            } else if (starts(line, "field ")) {
                if (!inStruct || inFunction) {
                    fail(state, "struct field outside struct section");
                } else {
                    let rest: string = trim(slice(line, 6, length(line)));
                    let sp: i64 = findText(rest, " ", 0);
                    if (sp < 0 || trim(slice(rest, 0, sp)) == "" || trim(slice(rest, sp + 1, length(rest))) == "") {
                        fail(state, "malformed struct field");
                    } else {
                        i = i + 1;
                    }
                }
            } else if (starts(line, "function ")) {
                if (inFunction || inStruct) {
                    fail(state, "function declaration in invalid position");
                } else {
                    state.labels = [];
                    state.defs = [];
                    state.knownNames = [];
                    state.targets = [];
                    let open: i64 = findText(line, "(", 9);
                    state.currentFunction = trim(slice(line, 9, open));
                    if (open < 0 || state.currentFunction == "") {
                        fail(state, "malformed function signature");
                    } else if (!addUnique(state.functions, state.currentFunction)) {
                        fail(state, "duplicate function " + state.currentFunction);
                    } else {
                        markParams(state, line);
                        if (state.ok) {
                            inFunction = true;
                            functionCount = functionCount + 1;
                        }
                    }
                    i = i + 1;
                }
            } else if (line == "endfunction") {
                if (!inFunction) {
                    fail(state, "unexpected endfunction");
                } else {
                    if (listLength(state.labels) == 0) {
                        fail(state, "function has no basic block label");
                    } else {
                        let j: i64 = 0;
                        while (j < listLength(state.targets) && state.ok) {
                            if (!contains(state.labels, state.targets[j])) fail(state, "control-flow target does not exist: " + state.targets[j]);
                            j = j + 1;
                        }
                    }
                    if (state.ok) inFunction = false;
                    i = i + 1;
                }
            } else if (!inFunction) {
                fail(state, "top-level RIR text is not allowed: " + line);
                i = i + 1;
            } else if (endsWith(line, ":")) {
                let label: string = trim(slice(line, 0, length(line) - 1));
                if (label == "") fail(state, "empty basic-block label");
                else if (!addUnique(state.labels, label)) fail(state, "duplicate label " + label);
                else i = i + 1;
            } else {
                checkInstruction(state, line);
                i = i + 1;
            }
        }
    }

    if (inStruct) {
        fail(state, "unterminated struct section");
        return 1;
    }
    if (inFunction) {
        fail(state, "unterminated function");
        return 1;
    }
    if (functionCount == 0) {
        fail(state, "RIR module contains no functions");
        return 1;
    }
    if (!contains(state.functions, "main")) {
        fail(state, "RIR module has no main function");
        return 1;
    }
    return 0;
}

function main() -> i64 {
    let rir: string = readFile("ir/input.rir");
    let state: VerifyState = new VerifyState();
    let result: i64 = verifyRir(rir, state);
    if (result == 0) {
        let summary: string = "RIR-1 OK\nfunctions=" + int_to_string(listLength(state.functions)) + "\n";
        writeFile("ir/verification.txt", summary);
        return 0;
    }
    writeFile("ir/verification.txt", "RIR-1 ERROR\n" + state.message + "\n");
    return 1;
}
