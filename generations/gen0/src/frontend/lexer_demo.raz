// First piece of the self-hosted compiler: a lexer written in Raz itself.
// It uses only the seed language and generic runtime primitives.

struct Token {
    kind: i64;
    text: string;
    pos: i64;
}

function isSpace(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

function isDigit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

function lexNumber(source: string, start: i64) -> Token {
    let i: i64 = start;
    while (i < length(source) && isDigit(source[i])) {
        i = i + 1;
    }
    let t: Token = new Token();
    t.kind = 1;
    t.text = slice(source, start, i);
    t.pos = start;
    return t;
}

function lex(source: string) -> List<Token> {
    let out: List<Token> = [];
    let i: i64 = 0;
    while (i < length(source)) {
        let c: i64 = source[i];
        if (isSpace(c)) {
            i = i + 1;
        } else if (isDigit(c)) {
            let t: Token = lexNumber(source, i);
            out = append(out, t);
            i = i + length(t.text);
        } else {
            let t: Token = new Token();
            t.kind = 2;
            t.text = slice(source, i, i + 1);
            t.pos = i;
            out = append(out, t);
            i = i + 1;
        }
    }
    return out;
}

function main() -> i64 {
    let tokens: List<Token> = lex("12+34");
    return tokens[1].kind;
}
