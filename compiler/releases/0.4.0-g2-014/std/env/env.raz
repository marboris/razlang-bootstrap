// Process environment and target metadata. The implementation is isolated in
// this module so the compiler core does not hard-code platform behavior.
use "std/env/env_native.hpp";

function getEnv(name: string) -> string {
    return std_env_get!(name);
}

function hasEnv(name: string) -> bool {
    return std_env_has!(name);
}

function osName() -> string {
    return std_env_os_name!();
}

function architecture() -> string {
    return std_env_architecture!();
}

// Program-wide target metadata. The compiler lowers these immutable globals to
// C++ const objects initialized through generated RIR initializer functions.
const RAZ_OS_NAME: string = osName();
const RAZ_ARCHITECTURE: string = architecture();
