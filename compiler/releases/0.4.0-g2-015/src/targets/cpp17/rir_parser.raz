function lineAt(lines: Ref<List<string>>, index: i64) -> string {
    if (index < 0) return "";
    if (index >= listLength(lines)) return "";
    return trim(lines[index]);
}

function trim(s: string) -> string {
    let a: i64 = 0;
    let b: i64 = length(s);
    let leftDone: bool = false;
    while (a < b && !leftDone) {
        if (charCodeAt(s, a) == 32 || charCodeAt(s, a) == 9) a = a + 1;
        else leftDone = true;
    }
    let rightDone: bool = false;
    while (b > a && !rightDone) {
        if (charCodeAt(s, b - 1) == 32 || charCodeAt(s, b - 1) == 9) b = b - 1;
        else rightDone = true;
    }
    return slice(s, a, b);
}

function cpp17_starts(s: string, prefix: string) -> bool {
    if (length(s) < length(prefix)) return false;
    return slice(s, 0, length(prefix)) == prefix;
}

function cpp17_findText(s: string, needle: string, from: i64) -> i64 {
    let n: i64 = length(needle);
    let i: i64 = from;
    if (n == 0) return from;
    while (i + n <= length(s)) {
        let j: i64 = 0;
        while (j < n && s[i + j] == needle[j]) j = j + 1;
        if (j == n) return i;
        i = i + 1;
    }
    return -1;
}

function splitLines(s: string) -> List<string> {
    let out: List<string> = [];
    let start: i64 = 0;
    let i: i64 = 0;
    while (i < length(s)) {
        if (charCodeAt(s, i) == 10) {
            push(out, slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < length(s)) push(out, slice(s, start, length(s)));
    return out;
}

function afterArrow(s: string) -> string {
    let p: i64 = cpp17_findText(s, "->", 0);
    if (p < 0) return "void";
    return trim(slice(s, p + 2, length(s)));
}

function addParam(f: Ref<FunctionMeta>, item: string) {
    let x: string = trim(item);
    if (x == "") return;
    let p: i64 = cpp17_findText(x, " ", 0);
    if (p < 0) return;
    push(f.paramTypes, trim(slice(x, 0, p)));
    push(f.params, trim(slice(x, p + 1, length(x))));
}

function rirTopLevelComma(value: string) -> i64 {
    let depth: i64 = 0;
    let quote: i64 = 0;
    let escaped: bool = false;
    let i: i64 = 0;
    while (i < length(value)) {
        let c: i64 = charCodeAt(value, i);
        if (quote != 0) {
            if (escaped) escaped = false;
            else if (c == 92) escaped = true;
            else if (c == quote) quote = 0;
        } else if (c == 34 || c == 39) quote = c;
        else if (c == 40 || c == 91 || c == 123) depth = depth + 1;
        else if (c == 41 || c == 93 || c == 125) depth = depth - 1;
        else if (c == 44 && depth == 0) return i;
        i = i + 1;
    }
    return -1;
}

function rirSplitArgs(value: string) -> List<string> {
    let parts: List<string> = [];
    let start: i64 = 0;
    let depth: i64 = 0;
    let quote: i64 = 0;
    let escaped: bool = false;
    let i: i64 = 0;
    while (i <= length(value)) {
        if (i < length(value)) {
            let c: i64 = charCodeAt(value, i);
            if (quote != 0) {
                if (escaped) escaped = false;
                else if (c == 92) escaped = true;
                else if (c == quote) quote = 0;
            } else if (c == 34 || c == 39) quote = c;
            else if (c == 40 || c == 91 || c == 123) depth = depth + 1;
            else if (c == 41 || c == 93 || c == 125) depth = depth - 1;
            else if (c == 44 && depth == 0) {
                let part: string = trim(slice(value, start, i));
                if (part != "") push(parts, part);
                start = i + 1;
            }
        }
        if (i == length(value)) {
            let last: string = trim(slice(value, start, i));
            if (last != "") push(parts, last);
        }
        i = i + 1;
    }
    return parts;
}

function parseRirCallParts(call: string, out: Ref<RirInstruction>) -> bool {
    let text: string = trim(call);
    let open: i64 = cpp17_findText(text, "(", 0);
    if (open <= 0 || !endsWith(text, ")")) return false;
    out.name = trim(slice(text, 0, open));
    out.operands = rirSplitArgs(slice(text, open + 1, length(text) - 1));
    return true;
}

function parseRirRhs(rhs: string, result: string, sourceLine: i64) -> RirInstruction {
    let ins: RirInstruction = new RirInstruction();
    ins.result = result;
    ins.type = "";
    ins.name = "";
    ins.operands = [];
    ins.line = sourceLine;
    let space: i64 = cpp17_findText(rhs, " ", 0);
    let head: string = rhs;
    let rest: string = "";
    if (space >= 0) {
        head = slice(rhs, 0, space);
        rest = trim(slice(rhs, space + 1, length(rhs)));
    }
    if (head == "const") {
        let typeEnd: i64 = cpp17_findText(rest, " ", 0);
        if (typeEnd < 0) ins.opcode = "invalid";
        else {
            ins.opcode = "const";
            ins.type = trim(slice(rest, 0, typeEnd));
            push(ins.operands, trim(slice(rest, typeEnd + 1, length(rest))));
        }
    } else if (head == "load" || head == "copy" || head == "ref") {
        ins.opcode = head;
        push(ins.operands, rest);
    } else if (head == "new") {
        ins.opcode = "new";
        ins.type = rest;
    } else if (head == "ref_field" || head == "field") {
        let dot: i64 = cpp17_findText(rest, ".", 0);
        if (dot < 0) ins.opcode = "invalid";
        else {
            ins.opcode = head;
            push(ins.operands, trim(slice(rest, 0, dot)));
            push(ins.operands, trim(slice(rest, dot + 1, length(rest))));
        }
    } else if (head == "ref_index" || head == "index") {
        let open: i64 = cpp17_findText(rest, "[", 0);
        if (open < 0 || !endsWith(rest, "]")) ins.opcode = "invalid";
        else {
            ins.opcode = head;
            push(ins.operands, trim(slice(rest, 0, open)));
            push(ins.operands, trim(slice(rest, open + 1, length(rest) - 1)));
        }
    } else if (head == "call") {
        ins.opcode = "call-result";
        if (!parseRirCallParts(rest, ins)) ins.opcode = "invalid";
    } else if (cpp17_starts(rhs, "list(") && endsWith(rhs, ")")) {
        ins.opcode = "list";
        ins.operands = rirSplitArgs(slice(rhs, 5, length(rhs) - 1));
    } else if (head == "add" || head == "sub" || head == "mul" || head == "div" || head == "mod" ||
        head == "eq" || head == "ne" || head == "lt" || head == "le" || head == "gt" || head == "ge" ||
        head == "and" || head == "or") {
        let comma: i64 = rirTopLevelComma(rest);
        if (comma < 0) ins.opcode = "invalid";
        else {
            ins.opcode = head;
            push(ins.operands, trim(slice(rest, 0, comma)));
            push(ins.operands, trim(slice(rest, comma + 1, length(rest))));
        }
    } else if (head == "neg" || head == "not" || head == "pos") {
        ins.opcode = head;
        push(ins.operands, rest);
    } else ins.opcode = "invalid";
    return ins;
}

function parseRirInstruction(line: string, sourceLine: i64) -> RirInstruction {
    let ins: RirInstruction = new RirInstruction();
    ins.opcode = "invalid";
    ins.result = "";
    ins.type = "";
    ins.name = "";
    ins.operands = [];
    ins.line = sourceLine;
    if (length(line) > 0 && charCodeAt(line, length(line) - 1) == 58) {
        ins.opcode = "label";
        ins.name = trim(slice(line, 0, length(line) - 1));
    } else if (cpp17_starts(line, "local-auto ") || cpp17_starts(line, "local ")) {
        let inferred: bool = cpp17_starts(line, "local-auto ");
        let prefix: i64 = 6;
        if (inferred) prefix = 11;
        let rest: string = trim(slice(line, prefix, length(line)));
        let sp: i64 = cpp17_findText(rest, " ", 0);
        if (sp >= 0) {
            if (inferred) ins.opcode = "local-auto";
            else ins.opcode = "local";
            ins.type = trim(slice(rest, 0, sp));
            ins.name = trim(slice(rest, sp + 1, length(rest)));
        }
    } else if (cpp17_starts(line, "store_ref ") || cpp17_starts(line, "store ")) {
        let refStore: bool = cpp17_starts(line, "store_ref ");
        let prefix: i64 = 6;
        if (refStore) prefix = 10;
        let rest: string = slice(line, prefix, length(line));
        let comma: i64 = rirTopLevelComma(rest);
        if (comma >= 0) {
            if (refStore) ins.opcode = "store_ref";
            else ins.opcode = "store";
            push(ins.operands, trim(slice(rest, 0, comma)));
            push(ins.operands, trim(slice(rest, comma + 1, length(rest))));
        }
    } else if (cpp17_starts(line, "jump ")) {
        ins.opcode = "jump";
        ins.name = trim(slice(line, 5, length(line)));
    } else if (cpp17_starts(line, "branch ")) {
        let rest: string = slice(line, 7, length(line));
        let q: i64 = cpp17_findText(rest, " ? ", 0);
        if (q >= 0) {
            let right: string = slice(rest, q + 3, length(rest));
            let colon: i64 = cpp17_findText(right, " : ", 0);
            if (colon >= 0) {
                ins.opcode = "branch";
                push(ins.operands, trim(slice(rest, 0, q)));
                push(ins.operands, trim(slice(right, 0, colon)));
                push(ins.operands, trim(slice(right, colon + 3, length(right))));
            }
        }
    } else if (line == "return") ins.opcode = "return";
    else if (cpp17_starts(line, "return ")) {
        ins.opcode = "return";
        push(ins.operands, trim(slice(line, 7, length(line))));
    } else if (cpp17_starts(line, "native-call ")) {
        ins.opcode = "native-call";
        push(ins.operands, trim(slice(line, 12, length(line))));
    } else if (cpp17_starts(line, "call ")) {
        ins.opcode = "call-statement";
        if (!parseRirCallParts(trim(slice(line, 5, length(line))), ins)) ins.opcode = "invalid";
    } else if (cpp17_starts(line, "field_set ")) {
        let rest: string = slice(line, 10, length(line));
        let eq: i64 = cpp17_findText(rest, " = ", 0);
        if (eq >= 0) {
            ins.opcode = "field_set";
            push(ins.operands, trim(slice(rest, 0, eq)));
            push(ins.operands, trim(slice(rest, eq + 3, length(rest))));
        }
    } else if (cpp17_starts(line, "%t")) {
        let eq: i64 = cpp17_findText(line, " = ", 0);
        if (eq > 2) return parseRirRhs(trim(slice(line, eq + 3, length(line))), trim(slice(line, 0, eq)), sourceLine);
    }
    return ins;
}

function cpp17_parseFunction(line: string) -> FunctionMeta {
    let f: FunctionMeta = new FunctionMeta();
    f.params = [];
    f.paramTypes = [];
    f.instructions = [];
    let open: i64 = cpp17_findText(line, "(", 0);
    let close: i64 = cpp17_findText(line, ")", open + 1);
    if (open < 0 || close < 0) return f;
    f.name = trim(slice(line, 9, open));
    let raw: string = slice(line, open + 1, close);
    let start: i64 = 0;
    let i: i64 = 0;
    while (i <= length(raw)) {
        if (i == length(raw) || charCodeAt(raw, i) == 44) {
            addParam(f, slice(raw, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    f.returnType = afterArrow(line);
    return f;
}

function parseRir(rir: string) -> BackendModule {
    let lines: List<string> = splitLines(rir);
    let module: BackendModule = new BackendModule();
    module.parseError = "";
    module.uses = [];
    module.globals = [];
    module.structs = [];
    module.functions = [];
    let i: i64 = 1;
    while (i < listLength(lines)) {
        let line: string = trim(lines[i]);
        if (line == "" || line == "rir 1") {
            i = i + 1;
        } else if (cpp17_starts(line, "use-quoted ")) {
            push(module.uses, "quoted:" + trim(slice(line, 11, length(line))));
            i = i + 1;
        } else if (cpp17_starts(line, "global-const-auto ") || cpp17_starts(line, "global-const ")) {
            let isAuto: bool = cpp17_starts(line, "global-const-auto ");
            let prefixLength: i64 = 13;
            if (isAuto) prefixLength = 18;
            let rest: string = trim(slice(line, prefixLength, length(line)));
            let firstSpace: i64 = cpp17_findText(rest, " ", 0);
            if (firstSpace >= 0) {
                let afterType: string = trim(slice(rest, firstSpace + 1, length(rest)));
                let secondSpace: i64 = cpp17_findText(afterType, " ", 0);
                if (secondSpace >= 0) {
                    let g: GlobalMeta = new GlobalMeta();
                    g.type = trim(slice(rest, 0, firstSpace));
                    g.name = trim(slice(afterType, 0, secondSpace));
                    g.initFunction = trim(slice(afterType, secondSpace + 1, length(afterType)));
                    g.isConst = true;
                    g.isAuto = isAuto;
                    push(module.globals, g);
                }
            }
            i = i + 1;
        } else if (cpp17_starts(line, "global-auto ") || cpp17_starts(line, "global ")) {
            let isAuto: bool = cpp17_starts(line, "global-auto ");
            let prefixLength: i64 = 7;
            if (isAuto) prefixLength = 12;
            let rest: string = trim(slice(line, prefixLength, length(line)));
            if (isAuto) {
                let firstSpace: i64 = cpp17_findText(rest, " ", 0);
                if (firstSpace >= 0) {
                    let afterType: string = trim(slice(rest, firstSpace + 1, length(rest)));
                    let secondSpace: i64 = cpp17_findText(afterType, " ", 0);
                    if (secondSpace >= 0) {
                        let g: GlobalMeta = new GlobalMeta();
                        g.type = trim(slice(rest, 0, firstSpace));
                        g.name = trim(slice(afterType, 0, secondSpace));
                        g.initFunction = trim(slice(afterType, secondSpace + 1, length(afterType)));
                        g.isConst = false;
                        g.isAuto = true;
                        push(module.globals, g);
                    }
                }
            } else {
                let sp: i64 = cpp17_findText(rest, " ", 0);
                if (sp >= 0) {
                    let g: GlobalMeta = new GlobalMeta();
                    g.type = trim(slice(rest, 0, sp));
                    g.name = trim(slice(rest, sp + 1, length(rest)));
                    g.isConst = false;
                    g.isAuto = false;
                    g.initFunction = "";
                    push(module.globals, g);
                }
            }
            i = i + 1;
        } else if (cpp17_starts(line, "struct ")) {
            let st: StructMeta = new StructMeta();
            st.name = trim(slice(line, 7, length(line)));
            st.fields = [];
            st.fieldTypes = [];
            i = i + 1;
            while (i < listLength(lines) && cpp17_starts(lineAt(lines, i), "field ")) {
                let fieldLine: string = trim(lines[i]);
                let rest: string = trim(slice(fieldLine, 6, length(fieldLine)));
                let p: i64 = cpp17_findText(rest, " ", 0);
                if (p >= 0) {
                    push(st.fieldTypes, trim(slice(rest, 0, p)));
                    push(st.fields, trim(slice(rest, p + 1, length(rest))));
                }
                i = i + 1;
            }
            push(module.structs, st);
        } else if (cpp17_starts(line, "function ")) {
            let f: FunctionMeta = cpp17_parseFunction(line);
            i = i + 1;
            while (i < listLength(lines) && lineAt(lines, i) != "endfunction") {
                let bodyLine: string = trim(lines[i]);
                if (bodyLine != "") {
                    let instruction: RirInstruction = parseRirInstruction(bodyLine, i + 1);
                    push(f.instructions, instruction);
                    if (instruction.opcode == "invalid" && module.parseError == "") {
                        module.parseError = "invalid RIR instruction at line " + int_to_string(i + 1) + ": " + bodyLine;
                    }
                }
                i = i + 1;
            }
            if (i < listLength(lines)) i = i + 1;
            push(module.functions, f);
        } else {
            if (module.parseError == "") module.parseError = "invalid RIR declaration at line " + int_to_string(i + 1) + ": " + line;
            i = i + 1;
        }
    }
    return module;
}

