// G2-012: token-aware source define expansion with direct-call syntax.
// Syntax:
//   define twice(x) { x + x }
//   let value: i64 = twice(4);
// Expansion happens after module resolution and before build-definition
// rewriting, parsing, and semantic validation. It is deliberately not a C
// preprocessor: there is no stringification, token-pasting, or conditional
// compilation in this first milestone.

struct RazMacroDefinition {
    name: string;
    params: List<string>;
    body: string;
}

struct RazMacroState {
    definitions: List<RazMacroDefinition>;
    failed: bool;
    error: string;
    errorOffset: i64;
    parsedEnd: i64;
    changed: bool;
    lastInvocationOffset: i64;
}

struct RazMacroCall {
    name: string;
    arguments: List<string>;
    start: i64;
    end: i64;
    closeToken: i64;
}

function macroFail(state: Ref<RazMacroState>, message: string, offset: i64) {
    if (!state.failed) {
        state.failed = true;
        state.error = message;
        state.errorOffset = offset;
    }
}

function macroSourceLine(source: string, offset: i64) -> i64 {
    let line: i64 = 1;
    let i: i64 = 0;
    while (i < offset && i < length(source)) {
        if (charCodeAt(source, i) == 10) line = line + 1;
        i = i + 1;
    }
    return line;
}

function blankMacroRange(source: string, start: i64, end: i64) -> string {
    let out: string = "";
    let i: i64 = start;
    while (i < end) {
        let c: i64 = charCodeAt(source, i);
        if (c == 10 || c == 13) out = out + slice(source, i, i + 1);
        else out = out + " ";
        i = i + 1;
    }
    return out;
}

function macroDefinitionIndex(state: Ref<RazMacroState>, name: string) -> i64 {
    let i: i64 = 0;
    while (i < listLength(state.definitions)) {
        if (state.definitions[i].name == name) return i;
        i = i + 1;
    }
    return -1;
}

function macroParameterIndex(params: List<string>, name: string) -> i64 {
    let i: i64 = 0;
    while (i < listLength(params)) {
        if (params[i] == name) return i;
        i = i + 1;
    }
    return -1;
}

function macroArgumentHasTokens(source: string) -> bool {
    let tokens: List<Token> = lex(source);
    return listLength(tokens) > 1;
}

function parseMacroDefinition(source: string, tokens: List<Token>, startIndex: i64, state: Ref<RazMacroState>) -> i64 {
    let count: i64 = listLength(tokens);
    if (startIndex + 2 >= count || tokens[startIndex + 1].kind != 1) {
        macroFail(state, "expected name after 'define'", tokens[startIndex].pos);
        return startIndex;
    }
    let name: string = tokens[startIndex + 1].text;
    if (macroDefinitionIndex(state, name) >= 0) {
        macroFail(state, "duplicate define '" + name + "'", tokens[startIndex + 1].pos);
        return startIndex;
    }
    if (tokens[startIndex + 2].kind != 20) {
        macroFail(state, "expected '(' after define name '" + name + "'", tokens[startIndex + 1].pos);
        return startIndex;
    }

    let params: List<string> = [];
    let cursor: i64 = startIndex + 3;
    let paramsDone: bool = false;
    if (cursor < count && tokens[cursor].kind == 21) {
        paramsDone = true;
        cursor = cursor + 1;
    }
    while (cursor < count && !paramsDone && !state.failed) {
        if (tokens[cursor].kind != 1) {
            macroFail(state, "expected identifier in parameter list for define '" + name + "'", tokens[cursor].pos);
            return startIndex;
        }
        if (macroParameterIndex(params, tokens[cursor].text) >= 0) {
            macroFail(state, "duplicate parameter '" + tokens[cursor].text + "' in define '" + name + "'", tokens[cursor].pos);
            return startIndex;
        }
        push(params, tokens[cursor].text);
        cursor = cursor + 1;
        if (cursor < count && tokens[cursor].kind == 26) {
            cursor = cursor + 1;
        } else if (cursor < count && tokens[cursor].kind == 21) {
            paramsDone = true;
            cursor = cursor + 1;
        } else {
            if (cursor < count) macroFail(state, "expected ',' or ')' in define parameter list", tokens[cursor].pos);
            else macroFail(state, "unterminated define parameter list", tokens[startIndex].pos);
            return startIndex;
        }
    }

    if (cursor >= count || tokens[cursor].kind != 22) {
        let offset: i64 = tokens[startIndex].pos;
        if (cursor < count) offset = tokens[cursor].pos;
        macroFail(state, "expected '{' before body of macro '" + name + "'", offset);
        return startIndex;
    }
    let bodyOpen: i64 = cursor;
    let depth: i64 = 1;
    cursor = cursor + 1;
    while (cursor < count && depth > 0) {
        if (tokens[cursor].kind == 22) depth = depth + 1;
        else if (tokens[cursor].kind == 23) depth = depth - 1;
        if (depth > 0) cursor = cursor + 1;
    }
    if (depth != 0 || cursor >= count) {
        macroFail(state, "unterminated body for define '" + name + "'", tokens[startIndex].pos);
        return startIndex;
    }

    let definition: RazMacroDefinition = new RazMacroDefinition();
    definition.name = name;
    definition.params = params;
    definition.body = slice(source, tokens[bodyOpen].pos + 1, tokens[cursor].pos);
    state.parsedEnd = tokens[cursor].pos + 1;
    let nextIndex: i64 = cursor + 1;
    if (nextIndex < count && tokens[nextIndex].kind == 24) {
        state.parsedEnd = state.parsedEnd + 1;
        nextIndex = nextIndex + 1;
    }
    push(state.definitions, definition);
    return nextIndex;
}

function extractMacroDefinitions(source: string, state: Ref<RazMacroState>) -> string {
    let tokens: List<Token> = lex(source);
    let count: i64 = listLength(tokens);
    let out: string = "";
    let sourceCursor: i64 = 0;
    let tokenCursor: i64 = 0;
    let braceDepth: i64 = 0;
    while (tokenCursor + 1 < count && !state.failed) {
        let token: Token = tokens[tokenCursor];
        if (braceDepth == 0 && token.kind == 52 && token.text == "define") {
            let nextToken: i64 = parseMacroDefinition(source, tokens, tokenCursor, state);
            if (state.failed) return "";
            out = out + slice(source, sourceCursor, token.pos);
            out = out + blankMacroRange(source, token.pos, state.parsedEnd);
            sourceCursor = state.parsedEnd;
            tokenCursor = nextToken;
        } else {
            if (token.kind == 22) braceDepth = braceDepth + 1;
            else if (token.kind == 23 && braceDepth > 0) braceDepth = braceDepth - 1;
            tokenCursor = tokenCursor + 1;
        }
    }
    return out + slice(source, sourceCursor, length(source));
}

function parseMacroCall(source: string, tokens: List<Token>, nameIndex: i64, state: Ref<RazMacroState>) -> RazMacroCall {
    let call: RazMacroCall = new RazMacroCall();
    call.name = tokens[nameIndex].text;
    call.arguments = [];
    call.start = tokens[nameIndex].pos;
    call.end = call.start + length(call.name);
    call.closeToken = nameIndex;
    let count: i64 = listLength(tokens);
    if (nameIndex + 1 >= count || tokens[nameIndex + 1].kind != 20) {
        macroFail(state, "expected '(' after macro invocation '" + call.name + "'", call.start);
        return call;
    }

    let openIndex: i64 = nameIndex + 1;
    let argStart: i64 = tokens[openIndex].pos + 1;
    let roundDepth: i64 = 1;
    let squareDepth: i64 = 0;
    let braceDepth: i64 = 0;
    let hadComma: bool = false;
    let cursor: i64 = openIndex + 1;
    let foundClose: bool = false;
    while (cursor < count - 1 && !foundClose) {
        let token: Token = tokens[cursor];
        if (token.kind == 20) roundDepth = roundDepth + 1;
        else if (token.kind == 21) {
            roundDepth = roundDepth - 1;
            if (roundDepth == 0) {
                let finalArg: string = slice(source, argStart, token.pos);
                if (hadComma || macroArgumentHasTokens(finalArg)) push(call.arguments, finalArg);
                call.end = token.pos + 1;
                call.closeToken = cursor;
                foundClose = true;
            }
        } else if (token.kind == 28) squareDepth = squareDepth + 1;
        else if (token.kind == 29 && squareDepth > 0) squareDepth = squareDepth - 1;
        else if (token.kind == 22) braceDepth = braceDepth + 1;
        else if (token.kind == 23 && braceDepth > 0) braceDepth = braceDepth - 1;
        else if (token.kind == 26 && roundDepth == 1 && squareDepth == 0 && braceDepth == 0) {
            push(call.arguments, slice(source, argStart, token.pos));
            argStart = token.pos + 1;
            hadComma = true;
        }
        cursor = cursor + 1;
    }
    if (!foundClose) macroFail(state, "unterminated invocation of macro '" + call.name + "'", call.start);
    return call;
}

function substituteMacroArguments(body: string, definition: RazMacroDefinition, arguments: List<string>) -> string {
    let tokens: List<Token> = lex(body);
    let out: string = "";
    let sourceCursor: i64 = 0;
    let i: i64 = 0;
    while (i + 1 < listLength(tokens)) {
        let token: Token = tokens[i];
        if (token.kind == 1) {
            let param: i64 = macroParameterIndex(definition.params, token.text);
            if (param >= 0) {
                out = out + slice(body, sourceCursor, token.pos) + arguments[param];
                sourceCursor = token.pos + length(token.text);
            }
        }
        i = i + 1;
    }
    return out + slice(body, sourceCursor, length(body));
}

function expandMacroPass(source: string, state: Ref<RazMacroState>) -> string {
    let tokens: List<Token> = lex(source);
    let out: string = "";
    let sourceCursor: i64 = 0;
    let i: i64 = 0;
    state.changed = false;
    while (i + 1 < listLength(tokens) && !state.failed) {
        let token: Token = tokens[i];
        let definitionIndex: i64 = -1;
        if (token.kind == 1) definitionIndex = macroDefinitionIndex(state, token.text);
        if (definitionIndex >= 0 && i + 1 < listLength(tokens) && tokens[i + 1].kind == 20) {
            state.lastInvocationOffset = token.pos;
            let call: RazMacroCall = parseMacroCall(source, tokens, i, state);
            if (state.failed) return "";
            let definition: RazMacroDefinition = state.definitions[definitionIndex];
            if (listLength(call.arguments) != listLength(definition.params)) {
                macroFail(state, "define '" + call.name + "' expects " + int_to_string(listLength(definition.params)) + " argument(s), got " + int_to_string(listLength(call.arguments)), call.start);
                return "";
            }
            let replacement: string = substituteMacroArguments(definition.body, definition, call.arguments);
            out = out + slice(source, sourceCursor, call.start) + replacement;
            sourceCursor = call.end;
            state.changed = true;
            i = call.closeToken + 1;
        } else {
            i = i + 1;
        }
    }
    if (state.failed) return "";
    if (!state.changed) return source;
    out = out + slice(source, sourceCursor, length(source));
    return out;
}

function expandRazMacros(source: string, sourcePath: string) -> string {
    let state: RazMacroState = new RazMacroState();
    state.definitions = [];
    state.failed = false;
    state.error = "";
    state.errorOffset = 0;
    state.parsedEnd = 0;
    state.changed = false;
    state.lastInvocationOffset = 0;

    let expanded: string = extractMacroDefinitions(source, state);
    if (state.failed) {
        print("razc: " + sourcePath + ":" + int_to_string(macroSourceLine(source, state.errorOffset)) + ": define error: " + state.error);
        return "";
    }

    let pass: i64 = 0;
    let lastPassSource: string = expanded;
    while (pass < 32) {
        lastPassSource = expanded;
        let passSource: string = expanded;
        expanded = expandMacroPass(passSource, state);
        if (state.failed) {
            print("razc: " + sourcePath + ":" + int_to_string(macroSourceLine(passSource, state.errorOffset)) + ": define error: " + state.error);
            return "";
        }
        if (!state.changed) return expanded;
        if (length(expanded) > 1048576) {
            print("razc: " + sourcePath + ": macro expansion exceeds 1 MiB");
            return "";
        }
        pass = pass + 1;
    }
    print("razc: " + sourcePath + ":" + int_to_string(macroSourceLine(lastPassSource, state.lastInvocationOffset)) + ": macro expansion exceeded 32 passes (possible recursive define)");
    return "";
}
