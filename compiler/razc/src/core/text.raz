function charCodeAt(value: Ref<string>, index: i64) -> i64 {
    if (index < 0) return -1;
    if (index >= length(value)) return -1;
    return value[index];
}

function findText(s: string, needle: string, from: i64) -> i64 {
    let n: i64 = length(needle);
    let i: i64 = from;
    if (n == 0) return from;
    while (i + n <= length(s)) {
        let j: i64 = 0;
        while (j < n && s[i + j] == needle[j]) j = j + 1;
        if (j == n) return i;
        i = i + 1;
    }
    return -1;
}

function starts(s: string, prefix: string) -> bool {
    if (length(s) < length(prefix)) return false;
    return slice(s, 0, length(prefix)) == prefix;
}

function endsWith(s: string, suffix: string) -> bool {
    if (length(s) < length(suffix)) return false;
    return slice(s, length(s) - length(suffix), length(s)) == suffix;
}

function containsText(xs: List<string>, value: string) -> bool {
    let i: i64 = 0;
    while (i < listLength(xs)) {
        if (xs[i] == value) return true;
        i = i + 1;
    }
    return false;
}



// Join fragments as a balanced tree. Repeated `out = out + fragment` copies
// the growing prefix and becomes quadratic when compiling the compiler itself.
function joinTextChunks(chunks: List<string>) -> string {
    let work: List<string> = chunks;
    while (listLength(work) > 1) {
        let next: List<string> = [];
        let i: i64 = 0;
        while (i < listLength(work)) {
            if (i + 1 < listLength(work)) push(next, work[i] + work[i + 1]);
            else push(next, work[i]);
            i = i + 2;
        }
        work = next;
    }
    if (listLength(work) == 0) return "";
    return work[0];
}
