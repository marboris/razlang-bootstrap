{
  "name": "raz-compiler-bootstrap",
  "private": true,
  "type": "module",
  "description": "Legacy bootstrap entry points only; native development and tests use CMake, Ninja, and CTest.",
  "scripts": {
    "build:gen0": "node scripts/build-native.mjs",
    "build:gen1": "node scripts/build-gen1.mjs",
    "build:gen2": "node scripts/build-gen2.mjs",
    "build:gen2:selfhost": "RAZ_BUILD_KIND=gen2-selfhost node scripts/build-gen2.mjs --self-host",
    "build:gen2:bundle": "node scripts/build-gen2.mjs --bundle-only",
    "test:gen2:fast": "make test-gen2-fast",
    "test:gen2:deep": "make test-gen2-deep",
    "test:gen2": "make test-gen2",
    "test:all": "make test-all"
  }
}
