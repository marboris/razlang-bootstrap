struct Point {
    x: i64;
    y: i64;
}

function choose(flag: bool) -> i64 {
    if (flag) {
        let value: i64 = 20;
    } else {
        let value: i64 = 22;
    }
    let point: Point = new Point();
    point.x = 40;
    point.y = 2;
    return point.x + point.y - 42;
}

return choose(true);
