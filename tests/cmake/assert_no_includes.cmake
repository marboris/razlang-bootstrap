if(NOT DEFINED CPP OR NOT EXISTS "${CPP}")
  message(FATAL_ERROR "CPP output does not exist: ${CPP}")
endif()
file(READ "${CPP}" CONTENTS)
if(CONTENTS MATCHES "#[ \t]*include[ \t]+[<\"]")
  message(FATAL_ERROR "expected no generated includes, but found one in ${CPP}")
endif()
if(NOT CONTENTS MATCHES "using raz_i64 = __INT64_TYPE__;")
  message(FATAL_ERROR "header-free output must define the GNU-compatible i64 mapping")
endif()
