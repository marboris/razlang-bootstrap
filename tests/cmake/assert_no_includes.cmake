if(NOT DEFINED CPP OR NOT EXISTS "${CPP}")
    message(FATAL_ERROR "CPP output path is missing")
endif()
file(READ "${CPP}" generated)
if(generated MATCHES "#include")
    message(FATAL_ERROR "Unexpected include in output that has no explicit dependencies")
endif()
if(generated MATCHES "raz_build_definition_RAZ_UNUSED_LABEL")
    message(FATAL_ERROR "Unused string build definition unexpectedly emitted")
endif()
