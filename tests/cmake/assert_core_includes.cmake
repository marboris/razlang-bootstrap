if(NOT DEFINED CPP OR NOT EXISTS "${CPP}")
  message(FATAL_ERROR "CPP output does not exist: ${CPP}")
endif()
file(READ "${CPP}" CONTENTS)
foreach(HEADER "string" "vector")
  if(NOT CONTENTS MATCHES "#[ \t]*include[ \t]+<${HEADER}>")
    message(FATAL_ERROR "explicit std.core omitted #include <${HEADER}>")
  endif()
endforeach()
foreach(HEADER "cstdint" "cstddef")
  if(CONTENTS MATCHES "#[ \t]*include[ \t]+<${HEADER}>")
    message(FATAL_ERROR "std.core injected unnecessary #include <${HEADER}>")
  endif()
endforeach()
if(CONTENTS MATCHES "#[ \t]*include[ \t]+\"raz_runtime\\.hpp\"")
  message(FATAL_ERROR "user program unexpectedly depends on raz_runtime.hpp")
endif()
if(NOT CONTENTS MATCHES "std::vector<raz_i64>")
  message(FATAL_ERROR "explicit-core fixture did not produce a Raz List as std::vector")
endif()
