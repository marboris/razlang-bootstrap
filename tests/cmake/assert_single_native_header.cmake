if(NOT DEFINED CPP OR NOT EXISTS "${CPP}")
  message(FATAL_ERROR "CPP output does not exist: ${CPP}")
endif()
file(READ "${CPP}" CONTENTS)
if(NOT CONTENTS MATCHES "#[ \t]*include[ \t]+<cstdint>")
  message(FATAL_ERROR "explicit use \"cstdint\" did not emit #include <cstdint>")
endif()
foreach(HEADER "cstddef" "string" "vector")
  if(CONTENTS MATCHES "#[ \t]*include[ \t]+<${HEADER}>")
    message(FATAL_ERROR "use \"cstdint\" unexpectedly injected #include <${HEADER}>")
  endif()
endforeach()
