rir 1
struct Box
  field List<i64> xs
function mutate(Ref<Box> b) -> void
entry:
    %r0 = ref b
    %r1 = ref_field %r0.xs
    %r2 = const i64 9
    call push(%r1, %r2)
    return
endfunction
function main() -> i64
entry:
    %v0 = new Box
    local Box b
    store b, %v0
    %r3 = ref b
    call mutate(%r3)
    return 0
endfunction
